{
  "manifest_version": 3,
  "name": "Fieldwork · AI Activity Collector",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "description": "Record approved AI-site request metadata to your local Fieldwork monitor.",
  "permissions": ["storage", "alarms"],
  "optional_permissions": ["webRequest"],
  "host_permissions": ["http://127.0.0.1/*"],
  "optional_host_permissions": ["https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://copilot.microsoft.com/*", "https://www.perplexity.ai/*", "https://grok.com/*", "https://chat.deepseek.com/*", "https://www.doubao.com/*", "https://yuanbao.tencent.com/*"],
  "background": {"service_worker": "worker.js"},
  "action": {"default_popup": "popup.html"}
}
