{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Observation.schema.json",
  "title": "Observation",
  "type": "object",
  "required": [
    "id",
    "run_id",
    "kind",
    "target_refs",
    "source",
    "summary",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "target_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source": {
      "type": "object",
      "required": [
        "adapter"
      ],
      "properties": {
        "adapter": {
          "type": "string"
        },
        "tool": {
          "type": [
            "string",
            "null"
          ]
        },
        "tool_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "invocation_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "summary": {
      "type": "string"
    },
    "structured": {
      "type": "object"
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
